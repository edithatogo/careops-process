{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credentialing observed workload and case evaluation",
  "description": "Privacy-minimised observed evidence. Runtime parser additionally enforces strict Python integer units and valid aware calendar instants. Reference tokens must be opaque, not identities.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "observation_id",
        "case_id",
        "source_system",
        "recorded_at_utc",
        "kind",
        "manual_touch_count",
        "active_work_minutes",
        "effort_complete"
      ],
      "properties": {
        "contract_version": {
          "const": "0.1.0"
        },
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "recorded_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "kind": {
          "const": "workload"
        },
        "manual_touch_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "active_work_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "effort_complete": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "observation_id",
        "case_id",
        "source_system",
        "recorded_at_utc",
        "kind",
        "alert_raised",
        "requirement_present",
        "evaluation_reference_version"
      ],
      "properties": {
        "contract_version": {
          "const": "0.1.0"
        },
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "recorded_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "kind": {
          "const": "evaluation"
        },
        "alert_raised": {
          "type": "boolean"
        },
        "requirement_present": {
          "type": "boolean"
        },
        "evaluation_reference_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    }
  ]
}
