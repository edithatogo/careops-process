{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careops:credentialing:capacity-evidence:0.1.0",
  "title": "Protected observed redeployment and external attribution evidence",
  "description": "Protected evidence records, not public aggregate projections. Validation does not authenticate artifacts, reviewers or source assertions.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "activities"
      ],
      "properties": {
        "kind": {
          "const": "redeployment_activity_definition"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity_rule"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "snapshot_id",
        "cohort",
        "eligible_worker_count",
        "observed_worker_count",
        "participating_worker_count",
        "higher_value_distinct_workers",
        "other_distinct_workers",
        "activities",
        "joint_groups",
        "source_complete",
        "distinct_person_aggregation_attested",
        "joint_counts_complete_attested",
        "activity_time_partition_attested",
        "purpose_union_counts_attested",
        "contract_version"
      ],
      "properties": {
        "kind": {
          "const": "redeployment_snapshot"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "cohort": {
          "$ref": "#/$defs/cohort"
        },
        "eligible_worker_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "observed_worker_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "participating_worker_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "higher_value_distinct_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "other_distinct_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity_count"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "joint_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/joint_group"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "source_complete": {
          "type": "boolean"
        },
        "distinct_person_aggregation_attested": {
          "type": "boolean"
        },
        "joint_counts_complete_attested": {
          "type": "boolean"
        },
        "activity_time_partition_attested": {
          "type": "boolean"
        },
        "purpose_union_counts_attested": {
          "type": "boolean"
        },
        "contract_version": {
          "const": "0.1.0"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "claim_id",
        "version",
        "evidence_digest",
        "cohort",
        "method_code",
        "method_version",
        "claimed_attributed_redeployment_minutes",
        "unit",
        "artifacts",
        "claim_kind"
      ],
      "properties": {
        "kind": {
          "const": "capacity_attribution_claim"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "cohort": {
          "$ref": "#/$defs/cohort"
        },
        "method_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "method_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "claimed_attributed_redeployment_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "unit": {
          "const": "minutes"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 4,
          "uniqueItems": true,
          "maxItems": 4
        },
        "claim_kind": {
          "const": "attributed_observed_redeployment"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evidence_digest",
        "claim_digest",
        "resolved_manifest_digest",
        "reviewer",
        "decided_at_utc",
        "decision",
        "scope"
      ],
      "properties": {
        "kind": {
          "const": "capacity_attribution_assessment"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "claim_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "resolved_manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "decided_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
        },
        "decision": {
          "enum": [
            "accepted_for_evaluation_record",
            "rejected",
            "needs_more_evidence"
          ]
        },
        "scope": {
          "const": "external_judgment_only"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifacts"
      ],
      "properties": {
        "kind": {
          "const": "resolved_capacity_evidence_manifest"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 4
        }
      }
    }
  ],
  "$defs": {
    "activity_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_code",
        "purpose"
      ],
      "properties": {
        "activity_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "purpose": {
          "enum": [
            "exception_management",
            "practitioner_support",
            "quality_assurance",
            "other"
          ]
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "activities"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity_rule"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_ref",
        "source_system",
        "aggregation_definition_version",
        "release_epoch",
        "start_utc",
        "end_utc",
        "activity_definition_digest"
      ],
      "properties": {
        "cohort_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "aggregation_definition_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "release_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "start_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
        },
        "activity_definition_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "activity_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_code",
        "observed_work_minutes",
        "distinct_observed_workers"
      ],
      "properties": {
        "activity_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "observed_work_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "distinct_observed_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "distinct_observed_workers": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "observed_work_minutes": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "observed_work_minutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000000
              }
            }
          }
        }
      ]
    },
    "joint_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_codes",
        "distinct_workers"
      ],
      "properties": {
        "activity_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "distinct_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "cohort",
        "eligible_worker_count",
        "observed_worker_count",
        "participating_worker_count",
        "higher_value_distinct_workers",
        "other_distinct_workers",
        "activities",
        "joint_groups",
        "source_complete",
        "distinct_person_aggregation_attested",
        "joint_counts_complete_attested",
        "activity_time_partition_attested",
        "purpose_union_counts_attested",
        "contract_version"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "cohort": {
          "$ref": "#/$defs/cohort"
        },
        "eligible_worker_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "observed_worker_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "participating_worker_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "higher_value_distinct_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "other_distinct_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity_count"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "joint_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/joint_group"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "source_complete": {
          "type": "boolean"
        },
        "distinct_person_aggregation_attested": {
          "type": "boolean"
        },
        "joint_counts_complete_attested": {
          "type": "boolean"
        },
        "activity_time_partition_attested": {
          "type": "boolean"
        },
        "purpose_union_counts_attested": {
          "type": "boolean"
        },
        "contract_version": {
          "const": "0.1.0"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "artifact_kind",
        "sha256"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "artifact_kind": {
          "enum": [
            "evaluation_method",
            "population_alignment",
            "evaluation_design",
            "study_results"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "version",
        "evidence_digest",
        "cohort",
        "method_code",
        "method_version",
        "claimed_attributed_redeployment_minutes",
        "unit",
        "artifacts",
        "claim_kind"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "cohort": {
          "$ref": "#/$defs/cohort"
        },
        "method_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "method_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "claimed_attributed_redeployment_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "unit": {
          "const": "minutes"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 4,
          "uniqueItems": true,
          "maxItems": 4
        },
        "claim_kind": {
          "const": "attributed_observed_redeployment"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_reference",
        "reviewer_role"
      ],
      "properties": {
        "reviewer_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
        },
        "reviewer_role": {
          "enum": [
            "process_owner",
            "assurance_reviewer"
          ]
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_digest",
        "claim_digest",
        "resolved_manifest_digest",
        "reviewer",
        "decided_at_utc",
        "decision",
        "scope"
      ],
      "properties": {
        "evidence_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "claim_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "resolved_manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "decided_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
        },
        "decision": {
          "enum": [
            "accepted_for_evaluation_record",
            "rejected",
            "needs_more_evidence"
          ]
        },
        "scope": {
          "const": "external_judgment_only"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 4
        }
      }
    }
  }
}
