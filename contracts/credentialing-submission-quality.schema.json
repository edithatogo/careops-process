{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careops:credentialing:first-submission-quality:0.1.0",
  "title": "Observed first-submission quality assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contract_version",
    "observation_id",
    "case_id",
    "source_system",
    "assessment_definition_version",
    "complete_at_first_submission",
    "recorded_at_utc"
  ],
  "properties": {
    "kind": {
      "const": "first_submission_quality"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "source_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "assessment_definition_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "complete_at_first_submission": {
      "type": "boolean"
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
    }
  }
}
