{
  "$defs": {
    "Code": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])",
      "type": "string"
    },
    "Minutes": {
      "minimum": 0,
      "type": "number"
    },
    "Reference": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])",
      "type": "string"
    },
    "WorkInterval": {
      "additionalProperties": false,
      "description": "An observed exclusive state interval, in offsets from the case span start.",
      "properties": {
        "start_minute": {
          "$ref": "#/$defs/Minutes"
        },
        "end_minute": {
          "$ref": "#/$defs/Minutes"
        },
        "state": {
          "enum": [
            "queue",
            "active",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "start_minute",
        "end_minute",
        "state"
      ],
      "title": "WorkInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One observed case/window assessment, with no free text or person identity.\n\nNone means unavailable; empty reasons mean an explicitly observed negative.\nA positive has one or more controlled process reason codes. Trace is the\nsource's observed administrative sequence, never an inferred sequence.",
  "properties": {
    "kind": {
      "const": "credentialing_case_reporting",
      "default": "credentialing_case_reporting",
      "title": "Kind",
      "type": "string"
    },
    "contract_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "observation_id": {
      "$ref": "#/$defs/Reference"
    },
    "case_id": {
      "$ref": "#/$defs/Reference"
    },
    "source_system": {
      "$ref": "#/$defs/Code"
    },
    "definition_version": {
      "$ref": "#/$defs/Code"
    },
    "window_code": {
      "$ref": "#/$defs/Code"
    },
    "pathway_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/Code"
        },
        {
          "type": "null"
        }
      ]
    },
    "correction_reasons": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Code"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Correction Reasons"
    },
    "further_information_reasons": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Code"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Further Information Reasons"
    },
    "deferral_reasons": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Code"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Deferral Reasons"
    },
    "exception_reasons": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Code"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exception Reasons"
    },
    "observed_trace": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "request_received",
              "request_classified",
              "duplicate_detected",
              "validation_failed",
              "correction_requested",
              "correction_received",
              "application_ready",
              "professional_review_requested",
              "professional_review_completed",
              "service_capability_attested",
              "fairness_notice_issued",
              "fairness_response_received",
              "committee_scheduled",
              "committee_deferred",
              "committee_considered",
              "recommendation_recorded",
              "decision_routed_to_delegate",
              "delegated_decision_recorded",
              "decision_communicated",
              "condition_applied",
              "supervision_plan_started",
              "temporary_approval_started",
              "temporary_approval_expired",
              "register_activation_requested",
              "register_activated",
              "register_reconciliation_failed",
              "renewal_reminder_issued",
              "review_commenced",
              "appeal_lodged",
              "review_or_appeal_decided",
              "case_completed",
              "case_withdrawn",
              "case_superseded"
            ],
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Trace"
    },
    "elapsed_minutes": {
      "anyOf": [
        {
          "$ref": "#/$defs/Minutes"
        },
        {
          "type": "null"
        }
      ]
    },
    "intervals": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/WorkInterval"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Intervals"
    }
  },
  "required": [
    "observation_id",
    "case_id",
    "source_system",
    "definition_version",
    "window_code",
    "pathway_code",
    "correction_reasons",
    "further_information_reasons",
    "deferral_reasons",
    "exception_reasons",
    "observed_trace",
    "elapsed_minutes",
    "intervals"
  ],
  "title": "CaseReportingObservation",
  "type": "object"
}
