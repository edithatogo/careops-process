{
  "additionalProperties": false,
  "description": "Record neutral review pointers, never credentials, tenant bindings or approval claims.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "mode": {
      "const": "dry_run_only",
      "default": "dry_run_only",
      "title": "Mode",
      "type": "string"
    },
    "lane": {
      "default": "unselected",
      "enum": [
        "unselected",
        "dataverse",
        "restricted_fallback"
      ],
      "title": "Lane",
      "type": "string"
    },
    "stage": {
      "default": "dev",
      "enum": [
        "dev",
        "test",
        "prod"
      ],
      "title": "Stage",
      "type": "string"
    },
    "classification": {
      "default": "unconfirmed",
      "enum": [
        "unconfirmed",
        "low_sensitivity_metadata",
        "protected"
      ],
      "title": "Classification",
      "type": "string"
    },
    "operating_model_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
