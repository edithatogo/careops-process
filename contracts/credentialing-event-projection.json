{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/careops-process/contracts/credentialing-event-projection.json",
  "title": "CareOps credentialing privacy-minimised event projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "ontology_version",
    "source",
    "watermark_utc",
    "facts"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "ontology_version": {
      "const": "0.1.0"
    },
    "source": {
      "enum": [
        "careops-approve",
        "careops-decisions",
        "dataverse",
        "sharepoint",
        "power-automate",
        "authoritative-register"
      ]
    },
    "watermark_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "activity",
        "timestamp_utc",
        "source_system",
        "object_ids",
        "observed_or_inferred",
        "confidence",
        "qualifiers"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/safe_id"
        },
        "activity": {
          "enum": [
            "request_received",
            "request_classified",
            "duplicate_detected",
            "validation_failed",
            "correction_requested",
            "correction_received",
            "application_ready",
            "professional_review_requested",
            "professional_review_completed",
            "service_capability_attested",
            "fairness_notice_issued",
            "fairness_response_received",
            "committee_scheduled",
            "committee_deferred",
            "committee_considered",
            "recommendation_recorded",
            "decision_routed_to_delegate",
            "delegated_decision_recorded",
            "decision_communicated",
            "condition_applied",
            "supervision_plan_started",
            "temporary_approval_started",
            "temporary_approval_expired",
            "register_activation_requested",
            "register_activated",
            "register_reconciliation_failed",
            "renewal_reminder_issued",
            "review_commenced",
            "appeal_lodged",
            "review_or_appeal_decided",
            "case_completed",
            "case_withdrawn",
            "case_superseded"
          ]
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "object_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_id"
          }
        },
        "observed_or_inferred": {
          "enum": [
            "observed",
            "inferred"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "qualifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pathway_code": {
              "type": "string",
              "maxLength": 80
            },
            "professional_stream": {
              "type": "string",
              "maxLength": 80
            },
            "facility_or_service_type": {
              "type": "string",
              "maxLength": 80
            },
            "exception_code": {
              "type": "string",
              "maxLength": 120
            },
            "feature_pack_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "authority_mapping_version": {
              "type": "string",
              "maxLength": 80
            },
            "duration_bucket": {
              "enum": [
                "under_1_day",
                "1_to_3_days",
                "4_to_7_days",
                "8_to_14_days",
                "15_to_30_days",
                "over_30_days",
                "not_applicable"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "observed_or_inferred": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "confidence": {
                "const": 1
              }
            }
          }
        }
      ]
    }
  }
}
