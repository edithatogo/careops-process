{
  "additionalProperties": false,
  "description": "Configure explicit synthetic owners and bounded recovery attempts.",
  "properties": {
    "execution_mode": {
      "const": "synthetic",
      "default": "synthetic",
      "title": "Execution Mode",
      "type": "string"
    },
    "policy_ref": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
      "title": "Policy Ref",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
      "title": "Scope Ref",
      "type": "string"
    },
    "owner_refs": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Owner Refs",
      "type": "array"
    },
    "maximum_attempts": {
      "maximum": 10,
      "minimum": 1,
      "title": "Maximum Attempts",
      "type": "integer"
    },
    "retry_delay_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Retry Delay Seconds",
      "type": "integer"
    }
  },
  "required": [
    "policy_ref",
    "scope_ref",
    "owner_refs",
    "maximum_attempts",
    "retry_delay_seconds"
  ],
  "title": "RecoveryPolicy",
  "type": "object"
}
