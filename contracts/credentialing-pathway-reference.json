{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credentialing versioned pathway reference",
  "description": "A source-linked comparison model, not evidence of policy approval. Runtime additionally checks required and terminal activities are permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_id",
    "version",
    "pathway_code",
    "authority_mapping_version",
    "source_reference",
    "required_stages",
    "permitted_activities",
    "terminal_activities"
  ],
  "properties": {
    "reference_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "not": {
        "pattern": "[^0-9.]"
      }
    },
    "pathway_code": {
      "enum": [
        "changed-scope",
        "conditions-supervision",
        "mutual-recognition",
        "register-reconciliation",
        "review-appeal",
        "routine-renewal",
        "temporary-approval"
      ]
    },
    "authority_mapping_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "source_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "required_stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 33,
      "uniqueItems": true,
      "items": {
        "enum": [
          "request_received",
          "request_classified",
          "duplicate_detected",
          "validation_failed",
          "correction_requested",
          "correction_received",
          "application_ready",
          "professional_review_requested",
          "professional_review_completed",
          "service_capability_attested",
          "fairness_notice_issued",
          "fairness_response_received",
          "committee_scheduled",
          "committee_deferred",
          "committee_considered",
          "recommendation_recorded",
          "decision_routed_to_delegate",
          "delegated_decision_recorded",
          "decision_communicated",
          "condition_applied",
          "supervision_plan_started",
          "temporary_approval_started",
          "temporary_approval_expired",
          "register_activation_requested",
          "register_activated",
          "register_reconciliation_failed",
          "renewal_reminder_issued",
          "review_commenced",
          "appeal_lodged",
          "review_or_appeal_decided",
          "case_completed",
          "case_withdrawn",
          "case_superseded"
        ]
      }
    },
    "permitted_activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 33,
      "uniqueItems": true,
      "items": {
        "enum": [
          "request_received",
          "request_classified",
          "duplicate_detected",
          "validation_failed",
          "correction_requested",
          "correction_received",
          "application_ready",
          "professional_review_requested",
          "professional_review_completed",
          "service_capability_attested",
          "fairness_notice_issued",
          "fairness_response_received",
          "committee_scheduled",
          "committee_deferred",
          "committee_considered",
          "recommendation_recorded",
          "decision_routed_to_delegate",
          "delegated_decision_recorded",
          "decision_communicated",
          "condition_applied",
          "supervision_plan_started",
          "temporary_approval_started",
          "temporary_approval_expired",
          "register_activation_requested",
          "register_activated",
          "register_reconciliation_failed",
          "renewal_reminder_issued",
          "review_commenced",
          "appeal_lodged",
          "review_or_appeal_decided",
          "case_completed",
          "case_withdrawn",
          "case_superseded"
        ]
      }
    },
    "terminal_activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 33,
      "uniqueItems": true,
      "items": {
        "enum": [
          "request_received",
          "request_classified",
          "duplicate_detected",
          "validation_failed",
          "correction_requested",
          "correction_received",
          "application_ready",
          "professional_review_requested",
          "professional_review_completed",
          "service_capability_attested",
          "fairness_notice_issued",
          "fairness_response_received",
          "committee_scheduled",
          "committee_deferred",
          "committee_considered",
          "recommendation_recorded",
          "decision_routed_to_delegate",
          "delegated_decision_recorded",
          "decision_communicated",
          "condition_applied",
          "supervision_plan_started",
          "temporary_approval_started",
          "temporary_approval_expired",
          "register_activation_requested",
          "register_activated",
          "register_reconciliation_failed",
          "renewal_reminder_issued",
          "review_commenced",
          "appeal_lodged",
          "review_or_appeal_decided",
          "case_completed",
          "case_withdrawn",
          "case_superseded"
        ]
      }
    }
  }
}
