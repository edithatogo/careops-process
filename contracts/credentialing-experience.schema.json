{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credentialing supplied single-select experience aggregates",
  "description": "Structural wire contract only. Runtime additionally validates unique question/category codes, exact reconciliation, source/instrument/cohort bindings and whole-report privacy. Source owners attest distinct-person aggregation; no respondent identifiers or raw survey content are accepted.",
  "oneOf": [
    {
      "$ref": "#/$defs/instrument"
    },
    {
      "$ref": "#/$defs/snapshot"
    }
  ],
  "$defs": {
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_ref",
        "definition_version",
        "epoch_ref",
        "window_start_utc",
        "window_end_utc",
        "source_system"
      ],
      "properties": {
        "cohort_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "definition_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "epoch_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "window_start_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?![\\s\\S])"
        },
        "window_end_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?![\\s\\S])"
        },
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_code",
        "scale_kind",
        "selection_mode",
        "categories"
      ],
      "properties": {
        "question_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "scale_kind": {
          "enum": [
            "nominal",
            "ordinal"
          ]
        },
        "selection_mode": {
          "const": "single_select"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
          },
          "uniqueItems": true
        }
      }
    },
    "questionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_code",
        "answered_count",
        "category_counts"
      ],
      "properties": {
        "question_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "answered_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "category_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              }
            ],
            "items": false
          },
          "uniqueItems": true
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "instrument_code",
        "version",
        "questions"
      ],
      "properties": {
        "kind": {
          "const": "experience_instrument"
        },
        "contract_version": {
          "const": "0.1.0"
        },
        "instrument_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "snapshot_ref",
        "source_system",
        "cohort",
        "instrument_code",
        "instrument_version",
        "instrument_digest",
        "distinct_person_aggregation_attested",
        "invited_count",
        "responded_count",
        "questions"
      ],
      "properties": {
        "kind": {
          "const": "experience_snapshot"
        },
        "contract_version": {
          "const": "0.1.0"
        },
        "snapshot_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "cohort": {
          "$ref": "#/$defs/cohort"
        },
        "instrument_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "instrument_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "instrument_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "distinct_person_aggregation_attested": {
          "type": "boolean"
        },
        "invited_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "responded_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/questionCounts"
          }
        }
      }
    }
  }
}
