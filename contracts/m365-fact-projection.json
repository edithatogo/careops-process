{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/careops-process/contracts/m365-fact-projection.json",
  "title": "CareOps low-privilege M365 fact projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source", "watermark", "facts"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "source": {"enum": ["dataverse", "teams", "outlook", "power-automate"]},
    "watermark": {"type": ["string", "null"], "format": "date-time"},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "activity", "timestamp_utc", "source_system", "object_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "activity": {"type": "string", "minLength": 1, "maxLength": 120},
          "timestamp_utc": {"type": "string", "format": "date-time"},
          "source_system": {"type": "string", "minLength": 1, "maxLength": 80},
          "object_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 128}}
        }
      }
    }
  }
}
