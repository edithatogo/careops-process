{
  "$defs": {
    "ParticipantResponse": {
      "additionalProperties": false,
      "description": "Record one authenticated-context response, with comments kept in protected records.",
      "properties": {
        "actor_ref": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "title": "Actor Ref",
          "type": "string"
        },
        "principal_ref": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "title": "Principal Ref",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "consultation",
            "recommendation",
            "endorsement",
            "approval",
            "noting",
            "ratification",
            "decline",
            "return_for_further_work"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "conflicted": {
          "default": false,
          "title": "Conflicted",
          "type": "boolean"
        },
        "recused": {
          "default": false,
          "title": "Recused",
          "type": "boolean"
        },
        "delegation_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delegation Ref"
        },
        "acting_arrangement_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acting Arrangement Ref"
        },
        "response_record_ref": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "title": "Response Record Ref",
          "type": "string"
        }
      },
      "required": [
        "actor_ref",
        "principal_ref",
        "outcome",
        "recorded_at",
        "response_record_ref"
      ],
      "title": "ParticipantResponse",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind response, chair, minute and ratification records to one rule and scope.",
  "properties": {
    "execution_mode": {
      "const": "synthetic",
      "default": "synthetic",
      "title": "Execution Mode",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
      "title": "Session Id",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
      "title": "Scope Ref",
      "type": "string"
    },
    "rule_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
      "title": "Rule Id",
      "type": "string"
    },
    "authority_source_ref": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
      "title": "Authority Source Ref",
      "type": "string"
    },
    "responses": {
      "items": {
        "$ref": "#/$defs/ParticipantResponse"
      },
      "title": "Responses",
      "type": "array"
    },
    "matter_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
      "title": "Matter Id",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
      "title": "Decision Id",
      "type": "string"
    },
    "template_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Template Version",
      "type": "string"
    },
    "review_cycle": {
      "minimum": 0,
      "title": "Review Cycle",
      "type": "integer"
    },
    "chair_confirmation_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chair Confirmation Ref"
    },
    "chair_confirmation_actor_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chair Confirmation Actor Ref"
    },
    "minute_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minute Ref"
    },
    "ratification_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ratification Ref"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    }
  },
  "required": [
    "session_id",
    "scope_ref",
    "rule_id",
    "authority_source_ref",
    "responses",
    "matter_id",
    "decision_id",
    "template_version",
    "review_cycle"
  ],
  "title": "DecisionSession",
  "type": "object"
}
