{
  "ontology_id": "careops-credentialing-process",
  "version": "0.1.0",
  "status": "blueprint-disabled-by-default",
  "extends": "careops-process:1.0.0",
  "objects": [
    "credentialing_case",
    "practitioner_reference",
    "application_pathway",
    "requested_scope",
    "facility_or_service",
    "evidence_manifest",
    "verification_summary",
    "professional_assessment",
    "service_capability_attestation",
    "governance_body",
    "committee_meeting",
    "recommendation",
    "delegated_decision",
    "condition",
    "supervision_plan",
    "temporary_approval",
    "register_activation_reference",
    "review_or_appeal",
    "source_object"
  ],
  "events": [
    "request_received",
    "request_classified",
    "duplicate_detected",
    "validation_failed",
    "correction_requested",
    "correction_received",
    "application_ready",
    "professional_review_requested",
    "professional_review_completed",
    "service_capability_attested",
    "fairness_notice_issued",
    "fairness_response_received",
    "committee_scheduled",
    "committee_deferred",
    "committee_considered",
    "recommendation_recorded",
    "decision_routed_to_delegate",
    "delegated_decision_recorded",
    "decision_communicated",
    "condition_applied",
    "supervision_plan_started",
    "temporary_approval_started",
    "temporary_approval_expired",
    "register_activation_requested",
    "register_activated",
    "register_reconciliation_failed",
    "renewal_reminder_issued",
    "review_commenced",
    "appeal_lodged",
    "review_or_appeal_decided",
    "case_completed",
    "case_withdrawn",
    "case_superseded"
  ],
  "qualifiers": [
    "source_system",
    "observed_or_inferred",
    "confidence",
    "pathway_code",
    "professional_stream",
    "facility_or_service_type",
    "exception_code",
    "feature_pack_version",
    "authority_mapping_version"
  ],
  "privacy": {
    "prohibitedFields": [
      "name",
      "email",
      "registration_number",
      "date_of_birth",
      "address",
      "free_text_evidence",
      "referee_text",
      "complaint_text",
      "investigation_text",
      "patient_information",
      "decision_reasons"
    ],
    "identifierPolicy": "pseudonymous-or-source-local-stable-reference",
    "smallCohortSuppressionRequired": true,
    "individualRankingProhibited": true
  },
  "inferencePolicy": {
    "observedEventsImmutable": true,
    "inferredEventsMustBeLabelled": true,
    "inferredEventsRequireConfidence": true,
    "aiMayNotCertifyConformance": true,
    "aiMayNotChangeSourceWorkflow": true
  }
}
