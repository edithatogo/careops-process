{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/careops-process/schemas/semantic-projection.schema.json",
  "title": "CareOps governed semantic projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at_utc", "activities", "families", "quality"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}},
    "families": {"type": "array", "items": {"$ref": "#/$defs/family"}},
    "quality": {"$ref": "#/$defs/quality"}
  },
  "$defs": {
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["activity", "count", "mean_duration_hours", "deviation_rate"],
      "properties": {
        "activity": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 0},
        "mean_duration_hours": {"type": "number", "minimum": 0}, "deviation_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "family": {
      "type": "object", "additionalProperties": false,
      "required": ["family_id", "label", "confidence"],
      "properties": {"family_id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["event_count", "object_count", "watermark_utc", "suppressed_small_cohort"],
      "properties": {"event_count": {"type": "integer", "minimum": 0}, "object_count": {"type": "integer", "minimum": 0}, "watermark_utc": {"type": ["string", "null"], "format": "date-time"}, "suppressed_small_cohort": {"type": "boolean"}}
    }
  }
}
