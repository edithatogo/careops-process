{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/careops-process/schemas/ocel2-careops.schema.json",
  "title": "CareOps OCEL 2.0 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["ocel_version", "log_id", "objects", "events", "lineage", "schema_version"],
  "properties": {
    "ocel_version": {"const": "2.0"},
    "log_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "lineage": {"type": "string", "minLength": 1, "maxLength": 500},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/object"}},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "object": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "object_type", "attributes"],
      "properties": {"object_id": {"$ref": "#/$defs/safeId"}, "object_type": {"type": "string", "minLength": 1}, "attributes": {"type": "object"}}
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "event_type", "timestamp_utc", "source_system", "observed_or_inferred", "confidence", "object_ids", "qualifiers"],
      "properties": {
        "event_id": {"$ref": "#/$defs/safeId"}, "event_type": {"type": "string", "minLength": 1},
        "timestamp_utc": {"type": "string", "format": "date-time"}, "source_system": {"type": "string", "minLength": 1},
        "observed_or_inferred": {"enum": ["observed", "inferred"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "object_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/safeId"}}, "qualifiers": {"type": "object"}
      }
    }
  }
}
