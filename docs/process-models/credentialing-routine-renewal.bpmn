<?xml version='1.0' encoding='utf-8'?>
<b:definitions xmlns:b="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:ddi="http://www.omg.org/spec/DD/20100524/DI" xmlns:di="http://www.omg.org/spec/BPMN/20100524/DI" id="credentialing-renewal" targetNamespace="urn:careops:credentialing:0.1.0">
  <b:process id="routine-renewal" isExecutable="false">
    <b:documentation>Generic observed-event baseline only; local branch applicability and authority require human review.</b:documentation>
    <b:startEvent id="start" name="Start" />
    <b:task id="stage-0" name="request received" />
    <b:task id="stage-1" name="request classified" />
    <b:task id="stage-2" name="application ready" />
    <b:task id="stage-3" name="committee scheduled" />
    <b:task id="stage-4" name="committee considered" />
    <b:task id="stage-5" name="recommendation recorded" />
    <b:task id="stage-6" name="decision routed to delegate" />
    <b:task id="stage-7" name="delegated decision recorded" />
    <b:task id="stage-8" name="decision communicated" />
    <b:task id="stage-9" name="register activation requested" />
    <b:task id="stage-10" name="register activated" />
    <b:task id="stage-11" name="case completed" />
    <b:task id="stage-12" name="renewal reminder issued" />
    <b:endEvent id="end" name="End" />
    <b:sequenceFlow id="flow-0" sourceRef="start" targetRef="stage-0" />
    <b:sequenceFlow id="flow-1" sourceRef="stage-0" targetRef="stage-1" />
    <b:sequenceFlow id="flow-2" sourceRef="stage-1" targetRef="stage-2" />
    <b:sequenceFlow id="flow-3" sourceRef="stage-2" targetRef="stage-3" />
    <b:sequenceFlow id="flow-4" sourceRef="stage-3" targetRef="stage-4" />
    <b:sequenceFlow id="flow-5" sourceRef="stage-4" targetRef="stage-5" />
    <b:sequenceFlow id="flow-6" sourceRef="stage-5" targetRef="stage-6" />
    <b:sequenceFlow id="flow-7" sourceRef="stage-6" targetRef="stage-7" />
    <b:sequenceFlow id="flow-8" sourceRef="stage-7" targetRef="stage-8" />
    <b:sequenceFlow id="flow-9" sourceRef="stage-8" targetRef="stage-9" />
    <b:sequenceFlow id="flow-10" sourceRef="stage-9" targetRef="stage-10" />
    <b:sequenceFlow id="flow-11" sourceRef="stage-10" targetRef="stage-11" />
    <b:sequenceFlow id="flow-12" sourceRef="stage-11" targetRef="stage-12" />
    <b:sequenceFlow id="flow-13" sourceRef="stage-12" targetRef="end" />
  </b:process>
  <di:BPMNDiagram id="renewal-diagram">
    <di:BPMNPlane id="renewal-plane" bpmnElement="routine-renewal">
      <di:BPMNShape id="start-shape" bpmnElement="start">
